# Flask session: generate with python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-value
COOKIE_SECURE=false

# Public URL used when creating absolute links for verification email and Midtrans callbacks.
PUBLIC_BASE_URL=http://localhost:5000
# Optional; default is the instance/into.sqlite3 SQLite database.
# INTO_DATABASE=C:/path/to/into.sqlite3

# SMTP (verification and ticket email). Gmail uses an App Password, not your normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
MAIL_FROM=your-gmail-address@gmail.com

# Midtrans Snap. Use matching sandbox keys and set production false during setup.
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-key
MIDTRANS_IS_PRODUCTION=false

# Optional comma-independent JSON object. Discount is an integer rupiah amount.
# Example: {"INTOHEMAT":{"discount_amount":10000,"expires_at":"2027-01-01T00:00:00+00:00"}}
INTO_VOUCHERS_JSON={}

# Configure the actual invite URL before sending ticket emails.
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/abcdefghijklmnopqrstuvwxyz
INTO_CONTACT_PERSONS=Rafi & Jongol

# Google Apps Script bridge for paid ticket orders (and the legacy order form).
# Configure the matching token in Apps Script Script Properties.
INTO_SHEETS_WEBHOOK_URL=
INTO_SHEETS_TOKEN=
